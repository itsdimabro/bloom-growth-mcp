              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/Scorecard"
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/scores/{scoreId}": {
      "get": {
        "tags": [
          "ScoresV2"
        ],
        "summary": "Returns one score, with `Week` set to the first day of the column Bloom shows it in.",
        "parameters": [
          {
            "name": "scoreId",
            "in": "path",
            "description": "The score's id.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "Include_Origin",
            "in": "query",
            "description": "When true, the score lists the meetings its KPI belongs to.",
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/Score"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Score"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/Score"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "ScoresV2"
        ],
        "summary": "Sets a score's value; a null value clears it. Pick the score by its `Week` from a v2 read\r\nso the value lands in that column. Same behavior as v1.",
        "parameters": [
          {
            "name": "scoreId",
            "in": "path",
            "description": "The score's id.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "description": "The new value, e.g. `{\"value\": 42}`.",
          "content": {
            "application/json-patch+json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateScore"
              }
            },
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateScore"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateScore"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateScore"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
