            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/Scorecard"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Scorecard"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/Scorecard"
                }
              }
            }
          }
        }
      }
    },
    "/token": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Get an access token",
        "description": "Exchanges a Bloom Growth user's email and password for an access token. No token is needed to call this endpoint.\n\n- Send the fields as a form (`application/x-www-form-urlencoded`).\n- The token lasts 14 days (`expires_in`, in seconds). There is no refresh token: request a new one when it expires.\n- Send the token as `Authorization: Bearer <access_token>` on every other request, or paste it into **Authorize** on this page.\n- Every request then runs as this user, with this user's permissions, in the organization the user last used in Bloom Growth.\n- Users who sign in with Google or Microsoft need to set a Bloom Growth password first, with **Forgot password?** on the sign-in page.",
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "required": [
                  "grant_type",
                  "userName",
                  "password"
                ],
                "type": "object",
                "properties": {
                  "grant_type": {
                    "enum": [
                      "password"
                    ],
                    "type": "string",
                    "description": "Always `password`.",
                    "default": "password"
                  },
                  "userName": {
                    "type": "string",
                    "description": "The user's Bloom Growth sign-in email.",
                    "format": "email"
                  },
                  "password": {
                    "type": "string",
                    "description": "The user's Bloom Growth password.",
                    "format": "password"
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The access token.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "access_token": {
                      "type": "string",
                      "description": "Send as `Authorization: Bearer <access_token>`."
                    },
                    "token_type": {
                      "type": "string",
                      "description": "Always `bearer`."
                    },
                    "expires_in": {
                      "type": "integer",
                      "description": "Seconds until the token expires (about 14 days)."
                    },
                    "userName": {
                      "type": "string",
                      "description": "The email the token was issued for, in lower case."
                    },
                    ".expires": {
                      "type": "string",
                      "description": "When the token expires, as a GMT date."
                    },
                    "user_id": {
                      "type": "integer",
                      "description": "The user's id in the organization the API works in. Use it wherever an endpoint asks for a `USER_ID`."
                    },
                    "organization_id": {
                      "type": "integer",
                      "description": "The organization the API works in for this user."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "`Authentication failed`: the email or password is wrong, or the user has no Bloom Growth password yet.",
            "content": {
              "application/json": {
                "example": {
                  "error": true,
                  "message": "Authentication failed"
                }
              }
            }
          }
        }
      }
    }
  },
